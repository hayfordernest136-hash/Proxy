# Server Configuration
PORT=4000
NODE_ENV=development

# Database (Railway MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=proxyzone

# Authentication
JWT_SECRET=change-this-to-a-strong-random-string-at-least-32-chars

# Frontend URL (for CORS and callback URLs)
FRONTEND_URL=http://localhost:5173

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
